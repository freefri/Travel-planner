{
    "name": "mf_travel",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently --names \"client,tailwind\" \"rspack serve\" \"npm run build:tailwind -- --watch\"",
        "build": "npm run build:tailwind && npm run build:client",
        "build:client": "rspack build --mode production --config rspack_prod.config.cjs",
        "build:tailwind": "npx @tailwindcss/cli -i ./src/styles/global.css -o ./public/tailwind.css",
        "serve": "rspack serve --config rspack_prod.config.cjs",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "setup": "npm install",
        "clean": "rimraf dist dist-ssr node_modules",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@radix-ui/react-slot": "^1.2.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.26.2",
        "jszip": "^3.10.1",
        "lucide-react": "^0.562.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "remeda": "^2.33.4",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@babel/core": "7.27.1",
        "@babel/preset-env": "^7.27.2",
        "@babel/preset-react": "^7.27.1",
        "@babel/preset-typescript": "^7.27.1",
        "@module-federation/enhanced": "0.14.0",
        "@rspack/cli": "1.1.1",
        "@rspack/core": "1.1.1",
        "@rspack/dev-server": "1.0.9",
        "@tailwindcss/cli": "^4.1.7",
        "@types/jszip": "^3.4.1",
        "@types/react": "18.3.3",
        "@types/react-dom": "18.3.0",
        "babel-loader": "9.1.3",
        "concurrently": "^9.1.2",
        "css-loader": "^7.1.2",
        "html-webpack-plugin": "5.6.0",
        "style-loader": "^4.0.0",
        "tailwindcss": "^4.1.7",
        "typescript": "^5.8.3"
    }
}